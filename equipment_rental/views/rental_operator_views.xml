<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_operator_list" model="ir.ui.view">
        <field name="name">rental.operator.list</field>
        <field name="model">rental.operator</field>
        <field name="arch" type="xml">
            <list string="Operators"
                  decoration-danger="license_expired"
                  decoration-warning="not license_expiry">
                <field name="code"/>
                <field name="name"/>
                <field name="role"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="license_number"/>
                <field name="license_expiry"/>
                <field name="license_expired"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rental_operator_form" model="ir.ui.view">
        <field name="name">rental.operator.form</field>
        <field name="model">rental.operator</field>
        <field name="arch" type="xml">
            <form string="Operator">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-tasks"
                                type="object" name="action_view_assignments">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Operator Name"/></h1>
                        <div class="o_row">
                            <field name="code" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Personal Info">
                            <field name="role"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="employee_id"/>
                            <field name="active"/>
                        </group>
                        <group string="License">
                            <field name="license_number"/>
                            <field name="license_expiry"/>
                            <field name="license_expired" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Competencies" name="competencies">
                            <field name="competency_ids">
                                <list editable="bottom" decoration-danger="expired">
                                    <field name="name"/>
                                    <field name="certificate_number"/>
                                    <field name="issuing_body"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="expired"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rental_operator" model="ir.actions.act_window">
        <field name="name">Operators</field>
        <field name="res_model">rental.operator</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_rental_operator_competency_list" model="ir.ui.view">
        <field name="name">rental.operator.competency.list</field>
        <field name="model">rental.operator.competency</field>
        <field name="arch" type="xml">
            <list string="Operator Competencies" decoration-danger="expired">
                <field name="operator_id"/>
                <field name="name"/>
                <field name="certificate_number"/>
                <field name="issuing_body"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="expired"/>
            </list>
        </field>
    </record>

    <record id="action_rental_operator_competency" model="ir.actions.act_window">
        <field name="name">Operator Competencies</field>
        <field name="res_model">rental.operator.competency</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
