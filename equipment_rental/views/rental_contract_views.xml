<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_contract_list" model="ir.ui.view">
        <field name="name">rental.contract.list</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <list string="Rental Contracts"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'completed'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="site_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="amount_total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
                <field name="quotation_id"/>
            </list>
        </field>
    </record>

    <record id="view_rental_contract_form" model="ir.ui.view">
        <field name="name">rental.contract.form</field>
        <field name="model">rental.contract</field>
        <field name="arch" type="xml">
            <form string="Rental Contract">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-success" invisible="state != 'draft'"/>
                    <button name="action_create_dispatch" string="Create Dispatch" type="object"
                            class="btn-primary" invisible="state != 'active'"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object"
                            invisible="state not in ('active','completed')"/>
                    <button name="action_complete" string="Mark Complete" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('cancelled','completed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_dispatches" icon="fa-truck">
                            <field name="dispatch_count" widget="statinfo" string="Dispatches"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_invoices" icon="fa-money">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Contract Info">
                            <field name="customer_id"/>
                            <field name="site_id"/>
                            <field name="quotation_id"/>
                            <field name="currency_id"/>
                        </group>
                        <group string="Period">
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="description"/>
                                    <field name="rental_basis"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="operator_id" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" string="Total Amount"
                                       class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Contract terms and notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_rental_contract" model="ir.actions.act_window">
        <field name="name">Rental Contracts</field>
        <field name="res_model">rental.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
