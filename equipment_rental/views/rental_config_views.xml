<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== SITE ===================== -->
    <record id="view_rental_site_list" model="ir.ui.view">
        <field name="name">rental.site.list</field>
        <field name="model">rental.site</field>
        <field name="arch" type="xml">
            <list string="Rental Sites">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_id"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_rental_site_form" model="ir.ui.view">
        <field name="name">rental.site.form</field>
        <field name="model">rental.site</field>
        <field name="arch" type="xml">
            <form string="Rental Site">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="partner_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="address" placeholder="Site address..."/>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_rental_site" model="ir.actions.act_window">
        <field name="name">Rental Sites</field>
        <field name="res_model">rental.site</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
