<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_rental_dispatch" model="ir.actions.report">
        <field name="name">Dispatch Note</field>
        <field name="model">rental.dispatch</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">equipment_rental.report_rental_dispatch_template</field>
        <field name="report_file">equipment_rental.report_rental_dispatch_template</field>
        <field name="binding_model_id" ref="model_rental_dispatch"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_rental_dispatch_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-3">
                            <div class="col-6">
                                <h2>Dispatch Note</h2>
                                <h3 t-esc="o.name"/>
                            </div>
                            <div class="col-6 text-end">
                                <div><strong>Dispatch Date:</strong> <span t-esc="o.dispatch_date"/></div>
                                <div><strong>Status:</strong>
                                    <span t-esc="dict(o._fields['state'].selection).get(o.state)"/>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <span t-esc="o.customer_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Site:</strong>
                                <span t-esc="o.site_id.name if o.site_id else 'N/A'"/>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Contract:</strong> <span t-esc="o.contract_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Driver:</strong> <span t-esc="o.driver_name or 'N/A'"/>
                                <br/>
                                <strong>Vehicle:</strong> <span t-esc="o.vehicle_plate or 'N/A'"/>
                            </div>
                        </div>

                        <h4>Equipment List</h4>
                        <table class="table table-sm table-bordered">
                            <thead class="table-secondary">
                                <tr>
                                    <th>#</th>
                                    <th>Code</th>
                                    <th>Equipment Name</th>
                                    <th>Make / Model</th>
                                    <th>Serial Number</th>
                                    <th>Condition (on departure)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.equipment_ids" t-as="eq">
                                    <tr>
                                        <td><t t-esc="eq_index + 1"/></td>
                                        <td><t t-esc="eq.code"/></td>
                                        <td><t t-esc="eq.name"/></td>
                                        <td><t t-esc="(eq.make or '') + ' ' + (eq.model_name or '')"/></td>
                                        <td><t t-esc="eq.serial_number or ''"/></td>
                                        <td>_______________</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <t t-if="o.notes">
                            <div class="mt-3">
                                <strong>Notes:</strong>
                                <p t-esc="o.notes"/>
                            </div>
                        </t>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>Dispatched by: _______________________</p>
                                <p>Signature: _______________________</p>
                                <p>Date/Time: _______________________</p>
                            </div>
                            <div class="col-6">
                                <p>Received by (Customer): _______________________</p>
                                <p>Signature: _______________________</p>
                                <p>Date/Time: _______________________</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
